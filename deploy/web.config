<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS (Windows Server) · Novedades Biblioteca Central USAC

  Copiar este archivo dentro de la carpeta donde se publique el contenido de
  dist/. Para que funcione la última sección hace falta el módulo URL Rewrite
  (https://www.iis.net/downloads/microsoft/url-rewrite); si no está instalado,
  borrar el bloque <rewrite> y el sitio seguirá funcionando igual, solo que una
  ruta inventada dará 404 en vez de volver al inicio.
-->
<configuration>
  <system.webServer>

    <!-- Nada de listados de directorio -->
    <directoryBrowse enabled="false" />

    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <httpProtocol>
      <customHeaders>
        <!-- IIS anuncia su versión; se quita -->
        <remove name="X-Powered-By" />

        <!-- Lo que el navegador tiene permitido cargar. La página no habla con
             ningún servidor externo: todo apunta a 'self'. -->
        <add name="Content-Security-Policy"
             value="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'none'; object-src 'none'; media-src 'none'; worker-src 'none'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests" />

        <!-- Nadie puede incrustar la página en un iframe (clickjacking) -->
        <add name="X-Frame-Options" value="DENY" />

        <!-- El navegador respeta el Content-Type y no lo adivina -->
        <add name="X-Content-Type-Options" value="nosniff" />

        <!-- No filtrar la ruta completa al salir hacia Biblos o las redes -->
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />

        <!-- Se renuncia a las APIs del navegador que la página no usa -->
        <add name="Permissions-Policy"
             value="accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()" />

        <add name="Cross-Origin-Opener-Policy" value="same-origin" />
        <add name="Cross-Origin-Resource-Policy" value="same-origin" />

        <!-- Descomentar SOLO con HTTPS y certificado válido en marcha -->
        <!-- <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" /> -->
      </customHeaders>
    </httpProtocol>

    <staticContent>
      <!-- IIS no conoce estos tipos de serie y los serviría como descarga -->
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>

    <security>
      <requestFiltering removeServerHeader="true">
        <!-- Extensiones que nunca deben servirse desde la carpeta pública -->
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".py" allowed="false" />
          <add fileExtension=".ts" allowed="false" />
          <add fileExtension=".md" allowed="false" />
          <add fileExtension=".map" allowed="false" />
          <add fileExtension=".config" allowed="false" />
        </fileExtensions>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment="tools" />
          <add segment="brand" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <rewrite>
      <rules>
        <!-- Forzar HTTPS (descomentar cuando haya certificado)
        <rule name="HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        -->

        <!-- Una sola pantalla: cualquier ruta desconocida vuelve al inicio -->
        <rule name="SPA" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <urlCompression doStaticCompression="true" doDynamicCompression="true" />
  </system.webServer>
</configuration>
